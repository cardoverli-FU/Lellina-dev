// ════════════════════════════════════════════════════════════════════
//  Lellina — Prisma Schema (Phase 2: Verification Gate + Registration)
//  Galz for Galz — South Africa (Cape Town)
//  NO MEN. NO BOTS. ONLY VERIFIED WOMEN.
// ════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── User ───────────────────────────────────────────────────────────
// Core account. Created AFTER verification passes. Admin bypasses gate
// (isVerified=true at seed time). faceEmbedding + referencePhoto are
// SYSTEM-ONLY — never exposed on discover/profile. Encrypted at rest.

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String?   @unique
  passwordHash    String

  // Verification state
  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?
  role            String    @default("USER") // "USER" | "ADMIN"

  // Night-trap biometric reference (SYSTEM-ONLY, encrypted, never public)
  // faceEmbedding = 128-dim Float vector as JSON string (encrypted)
  faceEmbedding   String?
  // referencePhoto = encrypted base64 blob (for admin appeal review)
  referencePhoto  String?

  // Country (set at /join, persisted at /register). Drives country isolation.
  // TZ users see only TZ profiles/districts. ZA users see only ZA.
  country         String?   // "ZA" | "TZ" | null (ISO alpha-2)

  // Device + ban tracking
  deviceFingerprint String?
  bannedAt        DateTime?
  banReason       String?

  // Lelly Pass (Phase 7 — fields exist now, logic ships later)
  lellyPassTier   String?   // "FOUNDING" | "STANDARD" | null
  lellyPassAt     DateTime?

  // Profile (1:1 — created during Phase 3 setup wizard)
  profile         Profile?

  // Verification attempts (1:N)
  verificationAttempts VerificationAttempt[]

  // Appeals submitted by this user (1:N)
  appeals         Appeal[]

  // Reports filed by this user (1:N)
  reportsFiled    Report[]   @relation("ReporterReports")

  // Admin audit log (1:N — admin actions taken)
  adminActions    AdminAuditLog[] @relation("AdminActions")

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?
  lastNightCheck  DateTime?

  // Like/Match relations (Phase 4)
  likesGiven      Like[]    @relation("LikerLikes")
  likesReceived   Like[]    @relation("LikedBy")
  matchesA        Match[]   @relation("MatchA")
  matchesB        Match[]   @relation("MatchB")

  // ─── Phase 5: Chat Engine relations ───
  chatRequestsSent      ChatRequest[]    @relation("ChatReqFrom")
  chatRequestsReceived  ChatRequest[]    @relation("ChatReqTo")
  conversationsA        Conversation[]   @relation("ConvUserA")
  conversationsB        Conversation[]   @relation("ConvUserB")
  messagesSent          Message[]        @relation("MsgSender")
  handleRequestsSent    HandleRequest[]  @relation("HandleReqFrom")
  ghostFlagsReported    GhostFlag[]      @relation("GhostFlagReporter")
  ghostFlagsAsGhost     GhostFlag[]      @relation("GhostFlagGhost")
  ghostNudgesSent       GhostNudge[]     @relation("GhostNudgeSender")
  ghostRedemption       GhostRedemption?
  deletedMessages       Message[]        @relation("MsgDeleter")

  @@index([email])
  @@index([deviceFingerprint])
  @@index([role])
  @@index([country])
}

// ─── Profile ────────────────────────────────────────────────────────
// Public profile shown on discover. Created in Phase 3 setup wizard.
// socialHandles hidden until mutual approval (Phase 5).

model Profile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName     String?
  age             Int?
  bio             String?
  // Photos stored as encrypted base64 or URLs (Phase 3)
  photoUrls       String    @default("[]") // JSON array

  // Location
  districtId      String?
  district        District? @relation(fields: [districtId], references: [id])
  streetTag       String?   // neighborhood-level free text

  // Tribe tags (up to 5) — stored as JSON array of tag IDs
  tribeTags       String    @default("[]")

  // Social handles (hidden until mutual approval — Phase 5)
  telegram        String?
  instagram       String?
  signal          String?
  otherSocial     String?   // Any other social media (TikTok, X, WhatsApp, etc.)

  // Discover state
  isOnline        Boolean   @default(false)
  lastActiveAt    DateTime?
  isFounder       Boolean   @default(false) // pinned first in discover

  // Ghost-score infrastructure (Phase 4A stores, Phase 5 calculates dynamically)
  // responseRateTier: shown as badge on every profile card.
  // ghostScore: 0-100, lower = worse. Null until first reply pattern recorded.
  responseRateTier String?  // "FAST" | "SLOW" | "GHOST" | "NEW"
  ghostScore       Float?
  ghostFlagCount   Int      @default(0)
  lastReplyAt      DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([districtId])
  @@index([isOnline])
  @@index([isFounder])
  @@index([responseRateTier])
}

// ─── District ───────────────────────────────────────────────────────
// Location model. Seeded with Cape Town (8) at launch.
// Expandable to new regions/countries as rollout continues.

model District {
  id              String    @id @default(cuid())
  name            String    @unique
  region          String    // e.g. "Cape Town"
  country         String    // e.g. "South Africa"
  areas           String    @default("[]") // JSON array of neighborhood names
  profiles        Profile[]
  createdAt       DateTime  @default(now())

  @@index([country])
  @@index([region])
}

// ─── TribeTag ───────────────────────────────────────────────────────
// Identity/subculture tags. Up to 5 per profile. Seeded at init.

model TribeTag {
  id              String    @id @default(cuid())
  name            String    @unique
  category        String    // "IDENTITY" | "SUBCULTURE" | "SCENE"
  createdAt       DateTime  @default(now())
}

// ─── VerificationAttempt ────────────────────────────────────────────
// Tracks each verification try. 3 max per device (Phase 2.9).
// NOTE: NO media stored here. Media is in-memory only, analyzed, discarded.
// Only the verdict + per-cloud scores persist for audit.

model VerificationAttempt {
  id              String    @id @default(cuid())
  userId          String?   // null if pre-registration (not yet a user)
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  deviceFingerprint String
  ipAddress       String

  // Verdict: "PASS" | "BAN" | "MANUAL_REVIEW" | "PENDING"
  verdict         String    @default("PENDING")

  // Per-cloud scores (JSON — e.g. {"L2":"female:0.98","L3":"female:0.95","L4":"clean"})
  cloudScores     String    @default("{}")

  // Which steps completed
  stepSelfie      Boolean   @default(false)
  stepVoice       Boolean   @default(false)
  stepVideo       Boolean   @default(false)
  stepConsensus   Boolean   @default(false)

  // Voice pitch (client-side, soft signal only)
  voicePitchHz    Float?

  // Video OCR code match
  videoCodeMatch  Boolean?

  failed          Boolean   @default(false)
  failReason      String?

  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([deviceFingerprint])
  @@index([verdict])
}

// ─── Appeal ─────────────────────────────────────────────────────────
// When a user is BANNED or sent to MANUAL_REVIEW, they can appeal.
// Appeal media: encrypted, auto-deleted 7 days after review closes.

model Appeal {
  id              String    @id @default(cuid())
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  deviceFingerprint String
  ipAddress       String

  // Original verification attempt that triggered the appeal
  attemptId       String?

  // Appeal media (encrypted base64 — auto-deleted 7 days post-review)
  appealPhoto     String?
  appealVoice     String?
  appealVideo     String?

  // User's message
  userMessage     String?

  // Review state: "PENDING" | "APPROVED" | "REJECTED" | "MORE_INFO" | "BANNED"
  status          String    @default("PENDING")
  adminNotes      String?
  reviewedBy      String?   // admin userId
  reviewedAt      DateTime?

  // Auto-delete media after 7 days post-review
  mediaDeleteAt   DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([userId])
}

// ─── Report ─────────────────────────────────────────────────────────
// Community moderation. Any user can report profiles, messages, events.
// No auto-nudity block — community + admin handle moderation.

model Report {
  id              String    @id @default(cuid())
  reporterId      String
  reporter        User      @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)

  // What's being reported: "PROFILE" | "MESSAGE" | "EVENT" | "PHOTO"
  targetType      String
  targetId        String

  // "ILLEGAL" | "HARASSMENT" | "IMPERSONATION" | "SPAM" | "UNDERAGE" | "OTHER"
  reason          String
  description     String?

  // Admin resolution: "PENDING" | "WARNED" | "SUSPENDED" | "BANNED" | "DISMISSED"
  status          String    @default("PENDING")
  adminNotes      String?
  reviewedBy      String?
  reviewedAt      DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([targetType, targetId])
}

// ─── AdminAuditLog ──────────────────────────────────────────────────
// Every admin action is logged. Approve appeal, ban user, dismiss report, etc.

model AdminAuditLog {
  id              String    @id @default(cuid())
  adminId         String
  admin           User      @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)

  action          String    // "APPROVE_APPEAL" | "REJECT_APPEAL" | "BAN_DEVICE" | "WARN_USER" | etc.
  targetType      String?   // "APPEAL" | "REPORT" | "USER"
  targetId        String?
  details         String?   // JSON blob with context

  createdAt       DateTime  @default(now())

  @@index([adminId])
  @@index([action])
}

// ─── VerificationToken ──────────────────────────────────────────────
// Issued by /verify on PASS. Required to access /register.
// Single-use, expires in 10 minutes.

model VerificationToken {
  id              String    @id @default(cuid())
  token           String    @unique
  deviceFingerprint String
  ipAddress       String
  attemptId       String?

  used            Boolean   @default(false)
  expiresAt       DateTime
  createdAt       DateTime  @default(now())

  @@index([token])
  @@index([deviceFingerprint])
}

// ─── Like (Phase 4.3) ───────────────────────────────────────────────
// A like or pass action. One action per user-pair (unique constraint).
// Mutual LIKE (A likes B + B likes A) → Match created atomically.

model Like {
  id        String   @id @default(cuid())
  likerId   String
  likedId   String
  action    String   // "LIKE" | "PASS"
  createdAt DateTime @default(now())

  liker     User     @relation("LikerLikes", fields: [likerId], references: [id], onDelete: Cascade)
  liked     User     @relation("LikedBy", fields: [likedId], references: [id], onDelete: Cascade)

  @@unique([likerId, likedId])
  @@index([likedId])
  @@index([likerId])
  @@index([action])
}

// ─── Match (Phase 4.3) ──────────────────────────────────────────────
// Created atomically when two users LIKE each other.
// userAId < userBId (lexicographic) to prevent duplicate matches.

model Match {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA     User     @relation("MatchA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("MatchB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

// ════════════════════════════════════════════════════════════════════
//  PHASE 5 — Chat Engine + Image Viewer + Anti-Ghosting
//  Request-first model: A sends ChatRequest → B accepts → Conversation
//  Free: 1 request/day, send pics (B receives blurred). Lelly: unlimited, unblurred, delete=ghost.
// ════════════════════════════════════════════════════════════════════

// ─── ChatRequest (Phase 5.8/5.9) ───────────────────────────────────
// A request to START a conversation. Free = 1/day, Lelly = unlimited.
// One active request per user-pair (unique). On ACCEPT → Conversation created.

model ChatRequest {
  id          String       @id @default(cuid())
  fromId      String
  toId        String
  message     String?      // optional intro note (max 280 chars, enforced in API)
  status      String       @default("PENDING") // "PENDING" | "ACCEPTED" | "DECLINED" | "EXPIRED"
  createdAt   DateTime     @default(now())
  respondedAt DateTime?
  expiresAt   DateTime?    // auto-expire after 7 days if no response

  from        User         @relation("ChatReqFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to          User         @relation("ChatReqTo", fields: [toId], references: [id], onDelete: Cascade)
  conversation Conversation? // created on ACCEPT (1:1)

  @@unique([fromId, toId])
  @@index([toId, status])
  @@index([fromId])
  @@index([status])
}

// ─── Conversation (Phase 5.2) ──────────────────────────────────────
// A 1:1 chat between two verified women. Created when a ChatRequest is ACCEPTED.
// userAId < userBId (lexicographic) — prevents duplicate conversations.
// Anti-ghosting: status tracks ACTIVE / CLOSED / EXITED.

model Conversation {
  id            String         @id @default(cuid())
  userAId       String         // lexicographically smaller userId
  userBId       String         // lexicographically larger userId
  requestId     String?        @unique // the ChatRequest that created this conversation
  status        String         @default("ACTIVE") // "ACTIVE" | "CLOSED" | "EXITED"
  closedBy      String?        // userId of who closed it
  exitReason    String?        // "NOT_FEELING_IT" | "GHOST_FLAG" | "MANUAL"
  exitMessage   String?        // the kind exit message sent (for NOT_FEELING_IT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastMessageAt DateTime?
  lastMessagePreview String?   // last message text (for conversation list preview)
  lastMessageSender String?    // userId of last sender

  userA         User           @relation("ConvUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User           @relation("ConvUserB", fields: [userBId], references: [id], onDelete: Cascade)
  request       ChatRequest?   @relation(fields: [requestId], references: [id])
  messages      Message[]
  handleRequests HandleRequest[]
  ghostFlags    GhostFlag[]
  ghostNudges   GhostNudge[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@index([status])
  @@index([lastMessageAt])
}

// ─── Message (Phase 5.2/5.5/5.6/5.7) ───────────────────────────────
// Individual chat message. Supports TEXT, PHOTO, SYSTEM, NOT_FEELING_IT, NUDGE.
// Read receipts: deliveredAt (sent to recipient socket), readAt (recipient opened).
// Photo blur: free recipients see blurred; Lelly recipients see unblurred.
// Delete (Lelly only): soft-delete — sets deletedAt, content nulled, disappears for BOTH.

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String?      // text content (null if photo-only or deleted)
  photoUrl       String?      // photo (URL or base64 — stored encrypted in prod)
  photoWidth     Int?
  photoHeight    Int?
  type           String       @default("TEXT") // "TEXT" | "PHOTO" | "SYSTEM" | "NOT_FEELING_IT" | "NUDGE"
  // Read receipts
  deliveredAt    DateTime?
  readAt         DateTime?
  // Lelly delete = disappears for BOTH (soft delete, content wiped)
  deletedById    String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MsgSender", fields: [senderId], references: [id], onDelete: Cascade)
  deleter        User?        @relation("MsgDeleter", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([readAt])
}

// ─── HandleRequest (Phase 5.4) ─────────────────────────────────────
// Social handles (Telegram/Instagram/Signal) are HIDDEN until mutual approval.
// One user requests to share handles → other accepts → handles revealed to both.

model HandleRequest {
  id             String       @id @default(cuid())
  conversationId String
  fromId         String       // who initiated the handle request
  status         String       @default("PENDING") // "PENDING" | "ACCEPTED" | "DECLINED"
  createdAt      DateTime     @default(now())
  respondedAt    DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  from           User         @relation("HandleReqFrom", fields: [fromId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([status])
}

// ─── GhostNudge (Phase 5.15) ───────────────────────────────────────
// After 3 days of silence in an ACTIVE conversation, the non-silent person can
// send ONE nudge ("Still there? 👋"). Max 1 nudge per conversation per 3-day window.

model GhostNudge {
  id             String       @id @default(cuid())
  conversationId String
  sentBy         String       // the non-silent person
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("GhostNudgeSender", fields: [sentBy], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ─── GhostFlag (Phase 5.17) ────────────────────────────────────────
// After 7+ days of silence, the non-silent person can "Report Ghosting".
// Accumulated flags → ghost reputation. Admin can warn/ban chronic ghosts.

model GhostFlag {
  id             String       @id @default(cuid())
  conversationId String
  reporterId     String       // who reported the ghost
  ghostId        String       // who is being reported as a ghost
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reporter       User         @relation("GhostFlagReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  ghost          User         @relation("GhostFlagGhost", fields: [ghostId], references: [id], onDelete: Cascade)

  @@unique([conversationId, reporterId]) // one flag per conversation per reporter
  @@index([ghostId])
  @@index([conversationId])
}

// ─── GhostRedemption (Phase 5.18) ──────────────────────────────────
// Tracks consecutive days a user replies within 24h.
// 14 consecutive days → badge upgrades: GHOST → SLOW → FAST.
// A single slow reply (>24h) resets the counter to 0.

model GhostRedemption {
  id              String    @id @default(cuid())
  userId          String    @unique
  consecutiveDays Int       @default(0)
  lastFastReplyAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([consecutiveDays])
}
